import fs from 'node:fs/promises';
import { execFileSync } from 'node:child_process';
import { existsSync, readdirSync, readFileSync, statSync, writeFileSync } from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { assertSafeId } from './security.js';
const NODE_PTY_VERSION = '1.2.0-beta.15';
let ptyModulePromise;
async function loadPty() {
    ptyModulePromise ??= import('node-pty');
    return ptyModulePromise;
}
function ptyUnavailableMessage(error) {
    const detail = error instanceof Error ? error.message : String(error);
    return `node-pty is optional and could not be loaded: ${detail}. Base Agent Interop features remain available; Freebuff CLI PTY mode requires a working node-pty install for this Node/platform combination.`;
}
function runningFreebuffClis(file) {
    if (process.platform !== 'win32')
        return [];
    const want = path.resolve(file).toLowerCase();
    const out = execFileSync('powershell', ['-NoProfile', '-Command', "Get-CimInstance Win32_Process -Filter \"Name='freebuff.exe'\" | % { \"$($_.ProcessId)|$($_.ExecutablePath)|$($_.CommandLine)\" }"], { encoding: 'utf8', windowsHide: true });
    return out.split(/\r?\n/).map((l) => l.split('|')).filter(([, exe, cmd]) => exe && path.resolve(exe).toLowerCase() === want && !/--terminal-command-broker/.test(cmd ?? ''))
        .map(([pid, , cmd]) => `pid ${pid} nativeId ${(/--continue\s+(\S+)/.exec(cmd ?? '') ?? [])[1] ?? '?'}`);
}
// Constraint: requires the CLI pid on line 1 of each chat log.jsonl.
function contextTokens(pid) {
    const root = path.join(os.homedir(), '.config', 'manicode', 'projects');
    let newest, at = 0;
    for (const proj of readdirSync(root, { withFileTypes: true }).filter((d) => d.isDirectory()))
        for (const chat of (() => { try { return readdirSync(path.join(root, proj.name, 'chats'), { withFileTypes: true }); } catch { return []; } })().filter((d) => d.isDirectory())) {
            const file = path.join(root, proj.name, 'chats', chat.name, 'run-state.json');
            const log = path.join(root, proj.name, 'chats', chat.name, 'log.jsonl');
            let owner = null;
            try { owner = JSON.parse(readFileSync(log, 'utf8').split(String.fromCharCode(10), 1)[0]).pid; } catch { }
            const m = existsSync(file) && owner === pid ? statSync(file).mtimeMs : 0;
            if (m > at) { at = m; newest = file; }
        }
    if (!newest) return 0;
    let text = '';
    try { text = readFileSync(newest, 'utf8'); } catch { return 0; }
    const counts = [...text.matchAll(/"contextTokenCount":(\d+)/g)].map((m) => Number(m[1]));
    return counts.length ? Math.max(...counts) : 0;
}
export async function probePty() {
    const command = process.platform === 'win32' ? (process.env.ComSpec ?? 'cmd.exe') : '/bin/echo';
    const args = process.platform === 'win32' ? ['/d', '/c', 'echo pty-probe'] : ['pty-probe'];
    try {
        const pty = await loadPty();
        const term = pty.spawn(command, args, {
            name: 'xterm-256color',
            cols: 80,
            rows: 24,
            ...(process.platform === 'win32' ? { useConpty: true } : {}),
            env: { ...process.env, TERM: 'xterm-256color' },
        });
        const result = await new Promise((resolve) => {
            let output = '';
            let settled = false;
            const finish = (value) => {
                if (settled)
                    return;
                settled = true;
                clearTimeout(timer);
                try {
                    term.kill();
                }
                catch { }
                resolve(value);
            };
            const timer = setTimeout(() => finish({
                ok: false,
                node: process.version,
                platform: process.platform,
                nodePty: NODE_PTY_VERSION,
                error: 'PTY probe timed out',
            }), Number(process.env.FREEBUFF_PTY_PROBE_TIMEOUT_MS ?? 10000));
            term.onData((data) => {
                output += data;
            });
            term.onExit(({ exitCode }) => {
                finish(exitCode === 0
                    ? { ok: true, node: process.version, platform: process.platform, nodePty: NODE_PTY_VERSION }
                    : {
                        ok: false,
                        node: process.version,
                        platform: process.platform,
                        nodePty: NODE_PTY_VERSION,
                        error: `probe exited with code ${exitCode}; output ${output.slice(-200)}`,
                    });
            });
        });
        return result;
    }
    catch (error) {
        return {
            ok: false,
            node: process.version,
            platform: process.platform,
            nodePty: NODE_PTY_VERSION,
            error: ptyUnavailableMessage(error),
        };
    }
}
function cliCandidates() {
    const home = os.homedir();
    const pathEntries = (process.env.PATH ?? '')
        .split(path.delimiter)
        .filter(Boolean)
        .flatMap((entry) => [
        path.join(entry, process.platform === 'win32' ? 'freebuff.exe' : 'freebuff'),
        path.join(entry, 'freebuff'),
    ]);
    return [
        process.env.FREEBUFF_CLI_PATH ?? '',
        path.join(home, '.config', 'manicode', 'freebuff.exe'),
        path.join(home, '.config', 'manicode', 'freebuff'),
        path.join(process.env.APPDATA ?? '', 'manicode', 'freebuff.exe'),
        path.join(process.env.LOCALAPPDATA ?? '', 'manicode', 'freebuff.exe'),
        ...pathEntries,
    ].filter(Boolean);
}
export async function findFreebuffCli() {
    for (const candidate of cliCandidates()) {
        try {
            const stat = await fs.stat(candidate);
            if (stat.isFile()) {
                if (process.platform !== 'win32')
                    await fs.access(candidate, fs.constants.X_OK);
                return candidate;
            }
        }
        catch {
            /* try next */
        }
    }
    return null;
}
export async function findLatestCliConversationId(cwd, minimumMtimeMs = 0) {
    const key = process.env.FREEBUFF_PROJECT_KEY ??
        `${path.basename(cwd)}--${(await import('node:crypto')).createHash('sha256').update(path.resolve(cwd)).digest('hex').slice(0, 12)}`;
    const roots = [
        path.join(os.homedir(), '.config', 'manicode', 'projects', key, 'chats'),
        path.join(os.homedir(), '.config', 'manicode', 'projects', path.basename(cwd), 'chats'),
    ];
    const candidates = [];
    for (const chats of roots)
        try {
            const entries = await fs.readdir(chats, { withFileTypes: true });
            for (const entry of entries) {
                if (!entry.isDirectory() || !/^[A-Za-z0-9._:-]{1,200}$/.test(entry.name))
                    continue;
                const dir = path.join(chats, entry.name);
                const [meta, state, log] = await Promise.all([
                    fs.stat(path.join(dir, 'chat-meta.json')).catch(() => null),
                    fs.stat(path.join(dir, 'run-state.json')).catch(() => null),
                    fs.stat(path.join(dir, 'log.jsonl')).catch(() => null),
                ]);
                const mtimeMs = Math.max(meta?.mtimeMs ?? 0, state?.mtimeMs ?? 0, log?.mtimeMs ?? 0);
                if (log && mtimeMs >= minimumMtimeMs)
                    candidates.push({ id: entry.name, mtimeMs });
            }
        }
        catch {
            /* try the legacy project key */
        }
    candidates.sort((a, b) => b.mtimeMs - a.mtimeMs);
    return candidates[0]?.id ?? null;
}
function visibleTerminalText(value) {
    return value
        .replace(/\x1b\[[0-?]*[ -/]*[@-~]/g, '')
        .replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/g, '');
}
let startChain = Promise.resolve();
// Invariant: freebuff starts must run one at a time so each sees the real settings file and its own spawn-check.
function lockStart() {
    let release;
    const mine = new Promise((r) => (release = r));
    const ready = startChain.then(() => release);
    startChain = startChain.then(() => mine);
    return ready;
}
function boardFooter(id, kind, modelKey) {
    return (modelKey ? ` The Command Center picked model ${modelKey} for this task.` : '') + (kind === 'read' ? ' This is a read-only task: do not edit, create, commit or push any file except the report file the task names.' : '') +
        ` Team board: other agents (DeepSeek and Beam coders, Solar Pro readers, Claude leads) share notes there. Read it before you start: curl.exe -s http://127.0.0.1:4021/board . Post what another agent needs (file maps, findings, blockers, a line when you finish): curl.exe -s -X POST "http://127.0.0.1:4021/board?from=${id}" --data-binary "your note" . Keep notes short and never post secrets.`;
}
function cliReady(output) {
    const visible = visibleTerminalText(output);
    const configured = process.env.FREEBUFF_CLI_READY_PATTERN;
    if (configured) {
        try {
            return new RegExp(configured, 'i').test(visible);
        }
        catch {
            /* fall back to safe built in markers */
        }
    }
    // Note: the bare word 'Freebuff' was removed from the default markers because the
    // 'already running' error also contains it and read as a false readiness signal.
    return /Enter a coding task|coding task|manicode|press .* to (send|submit)|[❯>]\s*$/im.test(visible);
}
export class CliPtyManager {
    sessions = new Map();
    writeQueues = new Map();
    progress(id, state, text, error) {
        const session = this.sessions.get(id);
        if (!session)
            throw new Error('FREEBUFF_CLI_SESSION_NOT_FOUND');
        const event = {
            sequence: ++session.sequence,
            threadId: id,
            timestamp: new Date().toISOString(),
            kind: error
                ? 'failed'
                : state === 'completed'
                    ? 'completed'
                    : state === 'running'
                        ? 'turn_state'
                        : 'unknown',
            state,
            text,
            error,
        };
        session.events.push(event);
        if (session.events.length > 200)
            session.events.shift();
        return {
            threadId: id,
            currentState: state,
            events: [...session.events],
            nextSequence: session.sequence + 1,
            connected: !session.exited,
            stale: false,
            latestEventAt: event.timestamp,
            phase: state === 'completed'
                ? 'completed'
                : state === 'failed'
                    ? 'failed'
                    : state === 'running'
                        ? 'unknown'
                        : 'unknown',
            lastMeaningfulUpdate: event.timestamp,
            lastError: error,
        };
    }
    snapshotState(id) {
        const session = this.sessions.get(id);
        if (!session)
            throw new Error('FREEBUFF_CLI_SESSION_NOT_FOUND');
        return {
            id,
            conversationId: session.conversationId,
            pid: session.term.pid,
            output: session.output,
            exited: session.exited,
            exitCode: session.exitCode,
            progress: {
                threadId: id,
                currentState: session.state,
                events: [...session.events],
                nextSequence: session.sequence + 1,
                connected: !session.exited,
                stale: false,
            },
        };
    }
    async start(id, cwd, continueId, kind = 'code', modelKey = '') {
        const safeId = assertSafeId(id);
        const existing = this.sessions.get(safeId);
        if (existing && !existing.exited)
            return this.snapshotState(safeId);
        if (existing?.exited)
            this.sessions.delete(safeId);
        const file = await findFreebuffCli();
        if (!file)
            throw new Error('FREEBUFF_CLI_NOT_INSTALLED');
        // Invariant: the CLI reads freebuffModelKey only at startup, so the role model is set just before spawn and restored once ready.
        const settingsFile = path.join(os.homedir(), '.config', 'manicode', 'settings.json');
        let savedSettings = null;
        const restoreSettings = () => { if (savedSettings != null) { try { writeFileSync(settingsFile, savedSettings); } catch { } savedSettings = null; } };
        let term, state;
        const release = await lockStart();
        try {
        // Invariant: a second freebuff CLI requires Command Center /spawn-check approval.
        const running = runningFreebuffClis(file);
        let check = null;
        try { check = await (await fetch(`http://127.0.0.1:4021/spawn-check?kind=${kind}${modelKey ? `&model=${encodeURIComponent(modelKey)}` : ''}&cli=${encodeURIComponent(safeId)}`, { signal: AbortSignal.timeout(8000) })).json(); } catch { }
        if (running.length && !check?.spawn)
            throw new Error(`FREEBUFF_SPAWN_BLOCKED: ${check ? check.why : 'Command Center (4021) is not answering, so only one CLI may run'} (running: ${running.join('; ')}). Send to that nativeId instead.`);
        if (check?.modelKey) {
            try {
                savedSettings = readFileSync(settingsFile, 'utf8');
                const parsed = JSON.parse(savedSettings);
                if (parsed.freebuffModelKey !== check.modelKey)
                    writeFileSync(settingsFile, JSON.stringify({ ...parsed, freebuffModelKey: check.modelKey }, null, 2));
                else
                    savedSettings = null;
            }
            catch {
                savedSettings = null;
            }
        }
        const args = ['--cwd', cwd];
        if (continueId)
            args.push('--continue', assertSafeId(continueId));
        const startedAt = Date.now();
        let pty;
        try {
            pty = await loadPty();
        }
        catch (error) {
            throw new Error(`FREEBUFF_PTY_UNAVAILABLE: ${ptyUnavailableMessage(error)}`);
        }
        try {
            term = pty.spawn(file, args, {
                name: 'xterm-256color',
                cols: 160,
                rows: 48,
                cwd,
                ...(process.platform === 'win32' ? { useConpty: true } : {}),
                env: { ...process.env, TERM: 'xterm-256color' },
            });
        }
        catch (error) {
            throw new Error(`FREEBUFF_PTY_START_FAILED: ${error instanceof Error ? error.message : String(error)}. Reinstall or rebuild the optional node-pty dependency for ${process.version} if Freebuff CLI PTY mode is required.`);
        }
        state = {
            term,
            cwd,
            startedAt,
            conversationId: continueId,
            output: '',
            exited: false,
            exitCode: undefined,
            events: [],
            sequence: 0,
            state: 'queued',
        };
        this.sessions.set(safeId, state);
        term.onData((data) => {
            state.output = (state.output + data).slice(-2_000_000);
            const visible = visibleTerminalText(data);
            if (/not authenticated|authentication failed|\bfatal\b/i.test(visible)) {
                state.state = 'failed';
                this.progress(safeId, 'failed', visible.slice(-500), visible.slice(-500));
            }
            else if (/\b(?:turn|task|session)\s+(?:completed|finished)\b|state\s*[:=]\s*idle/i.test(visible)) {
                state.state = 'completed';
                this.progress(safeId, 'completed', visible.slice(-500));
            }
        });
        term.onExit(({ exitCode }) => {
            state.exited = true;
            state.exitCode = exitCode;
            if (exitCode !== 0) {
                state.state = 'failed';
                this.progress(safeId, 'failed', undefined, `Freebuff CLI exited with code ${exitCode}`);
            }
        });
        const deadline = Date.now() + 12_000;
        while (Date.now() < deadline &&
            !cliReady(state.output) &&
            !/Not authenticated|Press ENTER to login/i.test(visibleTerminalText(state.output)))
            await new Promise((resolve) => setTimeout(resolve, 250));
        }
        finally {
            restoreSettings();
            release();
        }
        if (/Freebuff is already running/i.test(state.output) && process.env.FREEBUFF_CLI_TAKEOVER === '1') {
            term.write('\r');
            const takeoverDeadline = Date.now() + 8_000;
            while (Date.now() < takeoverDeadline && !cliReady(state.output))
                await new Promise((resolve) => setTimeout(resolve, 250));
        }
        if (/Freebuff is already running/i.test(visibleTerminalText(state.output)) && !cliReady(state.output)) {
            term.kill();
            this.sessions.delete(safeId);
            throw new Error('FREEBUFF_CLI_ALREADY_RUNNING');
        }
        if (/Not authenticated|Press ENTER to login/i.test(visibleTerminalText(state.output))) {
            term.kill();
            this.sessions.delete(safeId);
            throw new Error('FREEBUFF_CLI_NOT_AUTHENTICATED');
        }
        if (state.exited) {
            this.sessions.delete(safeId);
            throw new Error(`FREEBUFF_CLI_EXITED: exit code ${state.exitCode ?? 'unknown'}`);
        }
        if (!cliReady(state.output)) {
            term.kill();
            this.sessions.delete(safeId);
            throw new Error(`FREEBUFF_CLI_STARTUP_TIMEOUT: no machine readable readiness marker was detected. Set FREEBUFF_CLI_READY_PATTERN if this CLI exposes a custom marker. Output: ${visibleTerminalText(state.output).slice(-500)}`);
        }
        state.conversationId ??= (await findLatestCliConversationId(cwd, state.startedAt - 1000)) ?? undefined;
        return this.snapshotState(safeId);
    }
    async send(id, text, cwd = process.cwd(), continueId) {
        if (!text || text.length > 100_000)
            throw new Error('Message must be 1 to 100000 characters');
        const safeId = assertSafeId(id);
        const previous = this.writeQueues.get(safeId) ?? Promise.resolve();
        const result = previous
            .catch(() => undefined)
            .then(() => this.writePrompt(safeId, text, cwd, continueId));
        this.writeQueues.set(safeId, result.then(() => undefined, () => undefined));
        return result;
    }
    async typeLine(state, text) {
        state.term.write('\x15');
        await new Promise((resolve) => setTimeout(resolve, 50));
        state.term.write(`\x1b[200~${text}\x1b[201~`);
        await new Promise((resolve) => setTimeout(resolve, 50));
        state.term.write('\r');
        await new Promise((resolve) => setTimeout(resolve, 300));
    }
    async writePrompt(safeId, text, cwd, continueId) {
        const reused = this.sessions.has(safeId) && !this.sessions.get(safeId).exited;
        const tag = /^\s*\[(code|light|read)\]\s*/i.exec(text);
        const kind = tag ? tag[1].toLowerCase() : 'code';
        if (tag)
            text = text.slice(tag[0].length);
        const mtag = /^\s*\[model:([\w.-]{1,60})\]\s*/i.exec(text);
        const modelKey = mtag ? mtag[1] : '';
        if (mtag)
            text = text.slice(mtag[0].length);
        if (!text.startsWith('/'))
            text += boardFooter(safeId, kind, modelKey);
        const session = await this.start(safeId, cwd, continueId, kind, modelKey);
        if (!reused)
            await new Promise((resolve) => setTimeout(resolve, 2500));
        const state = this.sessions.get(safeId);
        if (!state || state.exited)
            throw new Error('FREEBUFF_CLI_SESSION_EXITED');
        state.state = 'queued';
        this.progress(safeId, 'queued');
        await new Promise((resolve) => setTimeout(resolve, 300));
        if (/^\/new\b/.test(text))
            state.conversationId = undefined;
        else if (reused && contextTokens(state.term.pid) > Number(process.env.FREEBUFF_COMPACT_AT ?? 150_000))
            await this.typeLine(state, '/compact');
        await this.typeLine(state, text);
        state.state = 'running';
        this.progress(safeId, 'running');
        state.conversationId ??= (await findLatestCliConversationId(cwd, state.startedAt - 1000)) ?? undefined;
        return this.snapshotState(safeId);
    }
    async sendToLatest(id, text, cwd = process.cwd()) {
        return this.send(id, text, cwd, (await findLatestCliConversationId(cwd)) ?? undefined);
    }
    async resumeLatest(id, cwd = process.cwd()) {
        return this.send(id, '/resume', cwd, (await findLatestCliConversationId(cwd)) ?? undefined);
    }
    stop(id) {
        const state = this.sessions.get(assertSafeId(id));
        if (!state)
            throw new Error('FREEBUFF_CLI_SESSION_NOT_FOUND');
        state.term.write('\x1b');
        return this.snapshotState(assertSafeId(id));
    }
    snapshot(id) {
        return this.snapshotState(assertSafeId(id));
    }
    dispose() {
        for (const state of this.sessions.values()) {
            if (!state.exited)
                state.term.kill();
        }
        this.sessions.clear();
    }
}
